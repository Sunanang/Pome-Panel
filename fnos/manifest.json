{
  "id": "com.pomepanel.sync",
  "name": "Pome Panel",
  "version": "0.9.8",
  "description": "在飞牛上查看 Pome Panel 工作区，并与桌面配对。界面走统一网关 /app/com.pomepanel.sync。没配端口时网关仍会启动；配好后固定监听 127.0.0.1。",
  "author": "Lando",
  "maintainer": "Lando",
  "distributor": "Lando",
  "arch": ["x86_64", "arm64"],
  "minFnOS": "0.8.0",
  "entry": {
    "start": "cmd/start.sh",
    "stop": "cmd/stop.sh",
    "status": "cmd/status.sh",
    "installCallback": "cmd/install_callback",
    "configCallback": "cmd/config_callback",
    "upgradeCallback": "cmd/upgrade_callback"
  },
  "appPath": "/app/com.pomepanel.sync",
  "socket": {
    "type": "unix",
    "pathHint": "app.sock"
  },
  "devicePort": {
    "enabled": true,
    "field": "wizard_port",
    "note": "有保存的端口就复用。没有或被占用时回退到系统分配的端口，并记住实际端口。代码不写死 5001。只认 deviceToken，永不信 X-Trim-*"
  },
  "ui": {
    "path": "app/ui",
    "wizard": "wizard",
    "install": "wizard/install",
    "config": "wizard/config"
  }
}
