{
  "id": "com.pomepanel.sync",
  "name": "Pome Panel Sync",
  "version": "0.1.0",
  "description": "Pome Panel × 飞牛 NAS 同步（P0 骨架；G0 真机前勿宣称通道可用）",
  "author": "Sunanang",
  "arch": ["x86_64", "arm64"],
  "minFnOS": "0.8.0",
  "entry": {
    "start": "cmd/start.sh",
    "stop": "cmd/stop.sh",
    "status": "cmd/status.sh"
  },
  "appPath": "/pomepanel-sync",
  "socket": {
    "type": "unix",
    "pathHint": "runtime/pomepanel-sync.sock"
  },
  "devicePort": {
    "enabled": true,
    "note": "端口不写死；运行时随机/配置并展示完整 URL；只认 deviceToken，永不信 X-Trim-*"
  },
  "ui": {
    "path": "app/ui",
    "wizard": "wizard"
  }
}
