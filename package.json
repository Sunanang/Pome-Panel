{
  "name": "pome-panel",
  "version": "0.11.0",
  "description": "Pome Panel - a local desktop workspace for macOS and Windows",
  "main": "main.js",
  "author": "Lando",
  "license": "MIT",
  "homepage": "https://github.com/Sunanang/Pome-Panel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunanang/Pome-Panel.git"
  },
  "bugs": {
    "url": "https://github.com/Sunanang/Pome-Panel/issues"
  },
  "scripts": {
    "setup:hooks": "node scripts/setup-git-hooks.js",
    "test": "node scripts/test-desktop.js",
    "start": "electron .",
    "build": "electron-builder --mac dmg --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:zip": "electron-builder --mac zip",
    "pack": "electron-builder --dir",
    "make-ico": "node scripts/make-ico.js",
    "check:work-hub": "node scripts/check-work-hub-baseline.js",
    "check:windows-spaces": "node tests/windows-spaces.native.cjs",
    "i18n:generate": "node scripts/localization-resources.js",
    "i18n:check": "node scripts/localization-resources.js --check"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.dynamicpanel.app",
    "productName": "Pome Panel",
    "artifactName": "Pome-Panel-${version}-${arch}.${ext}",
    "copyright": "© 2026 Lando",
    "asar": false,
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "afterPack": "./build/afterPack.js",
    "files": [
      "panelTiming.js",
      "atomicStorage.js",
      "taskInbox.js",
      "scripts/cursor-notify.js",
      "scripts/cursor-mcp-auth-notify.js",
      "scripts/pome-hook-runtime.ps1",
      "aiEventPolicy.js",
      "aiAttentionStore.js",
      "aiNotificationScheduler.js",
      "claudeAttentionAdapter.js",
      "scripts/claude-attention.js",
      "aiSourceHooks.js",
      "workspaceBackup.js",
      "syncRecovery.js",
      "main.js",
      "main-services.js",
      "todoReminders.js",
      "sunWeather.js",
      "userDataDirectory.js",
      "public-http.js",
      "aiProviderCatalog.js",
      "cursor-usage.js",
      "codex-usage.js",
      "codex-usage-remote.js",
      "codex-auth.js",
      "codex-thread-metadata.js",
      "grokbot-usage.js",
      "claude-usage.js",
      "copilot-usage.js",
      "grok-usage.js",
      "antigravity-usage.js",
      "manus-usage.js",
      "manusApi.js",
      "manusCompletionAdapter.js",
      "manusCompletionStore.js",
      "manusCompletionService.js",
      "platform.js",
      "platform-adapters/**/*",
      "preload.js",
      "sqliteProbe.js",
      "sync-store.js",
      "sync-migration.js",
      "todos-sync.js",
      "workspace-sync.js",
      "sync-settings.js",
      "sync-tls-trust.js",
      "packages/sync-protocol/**/*",
      "renderer/**/*",
      "scripts/codex-notify.js",
      "scripts/claude-notify.js",
      "scripts/grok-notify.js",
      "scripts/copilot-notify.js",
      "scripts/antigravity-notify.js",
      "scripts/completion-forwarder.js",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "build/pome-panel-icon.png",
      "build/pome-panel-icon.ico",
      "build/pome-panel-icon.icns",
      "build/pome-trayTemplate.png",
      "build/pome-trayTemplate@2x.png",
      "localization/runtime.js",
      "localization/resources.js",
      "localization/languages.json",
      "localization/locales/*.json"
    ],
    "mac": {
      "appId": "com.pomepanel.app",
      "icon": "build/pome-panel-icon.icns",
      "files": [
        "panelTiming.js",
        "atomicStorage.js",
        "taskInbox.js",
        "scripts/cursor-notify.js",
        "scripts/cursor-mcp-auth-notify.js",
        "scripts/pome-hook-runtime.ps1",
        "aiEventPolicy.js",
        "aiAttentionStore.js",
        "aiNotificationScheduler.js",
        "claudeAttentionAdapter.js",
        "scripts/claude-attention.js",
        "aiSourceHooks.js",
        "workspaceBackup.js",
        "syncRecovery.js",
        "main.js",
        "main-services.js",
        "todoReminders.js",
        "sunWeather.js",
        "userDataDirectory.js",
        "public-http.js",
        "aiProviderCatalog.js",
        "cursor-usage.js",
        "codex-usage.js",
        "codex-usage-remote.js",
        "codex-auth.js",
        "codex-thread-metadata.js",
        "grokbot-usage.js",
        "claude-usage.js",
        "copilot-usage.js",
        "grok-usage.js",
        "antigravity-usage.js",
        "manus-usage.js",
        "manusApi.js",
        "manusCompletionAdapter.js",
        "manusCompletionStore.js",
        "manusCompletionService.js",
        "platform.js",
        "platform-adapters/**/*",
        "preload.js",
        "sqliteProbe.js",
        "sync-store.js",
        "sync-migration.js",
        "todos-sync.js",
        "workspace-sync.js",
        "sync-settings.js",
        "sync-tls-trust.js",
        "packages/sync-protocol/**/*",
        "renderer/**/*",
        "scripts/codex-notify.js",
        "scripts/claude-notify.js",
        "scripts/grok-notify.js",
        "scripts/copilot-notify.js",
        "scripts/antigravity-notify.js",
        "scripts/completion-forwarder.js",
        "package.json",
        "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
        "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
        "!**/node_modules/.bin",
        "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
        "build/pome-panel-icon.png",
        "build/pome-panel-icon.ico",
        "build/pome-panel-icon.icns",
        "build/pome-trayTemplate.png",
        "build/pome-trayTemplate@2x.png",
        "!node_modules/koffi/**",
        "!node_modules/@koromix/**",
        "localization/runtime.js",
        "localization/resources.js",
        "localization/languages.json",
        "localization/locales/*.json"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "CFBundleDisplayName": "Pome Panel",
        "NSCameraUsageDescription": "Pome Panel uses the camera for the Mirror preview when you open it.",
        "NSMicrophoneUsageDescription": "Pome Panel uses the microphone to record audio when you start recording. Transcription is optional.",
        "NSAppleEventsUsageDescription": "Pome Panel uses System Events to list and focus windows and send Soda Music shortcuts.",
        "NSLocalNetworkUsageDescription": "Pome Panel accesses your NAS on the local network to sync your workspace.",
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "zh-Hant",
          "ja",
          "ko",
          "es",
          "fr",
          "de",
          "ru",
          "pt-BR"
        ]
      }
    },
    "win": {
      "icon": "build/pome-panel-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pome-Panel-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "displayLanguageSelector": false,
      "multiLanguageInstaller": true
    },
    "dmg": {
      "title": "Pome Panel ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "koffi": "~3.3.0",
    "lunar-javascript": "^1.7.7",
    "toml-eslint-parser": "^0.10.1",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
